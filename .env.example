# Presence (live map) server. Must be wss:// when the app is served over https.
# Leave unset in local dev to use ws://<this host>:8787.
VITE_PRESENCE_URL=wss://your-presence-service.onrender.com

# Clerk (Google sign-in): Clerk dashboard → API keys → Publishable key. When set, signing in with Google is required,
# and the server needs CLERK_SECRET_KEY from the same Clerk app. Leave unset for guest mode (device id, local dev).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key
